.{
    .exit_on_focus_change = false,
    .layouts = .{
        .{
            .name = "default",
            .root = .{
                .direction = .horizontal,
                .children = .{
                    .{ .command = .{"/bin/bash"}, .name = "left" },
                    .{ .command = .{"/bin/bash"}, .name = "right" },
                },
            },
        },
        .{
            .name = "dev",
            .root = .{
                .direction = .horizontal,
                .children = .{
                    .{
                        .command = .{"/bin/bash"},
                        .mouse = .passthrough,
                        .size = .{ .percent = 60 },
                        .name = "editor",
                    },
                    .{
                        .direction = .vertical,
                        .children = .{
                            .{ .command = .{"/bin/bash"}, .name = "server" },
                            .{ .command = .{"/bin/bash"}, .name = "terminal" },
                        },
                    },
                },
            },
        },
    },
    // Uncomment to customize keybindings:
    // .keymaps = .{
    //     .{ .key = "ctrl-q", .action = "quit" },
    //     .{ .key = "up", .action = "focus_up" },
    //     .{ .key = "down", .action = "focus_down" },
    //     .{ .key = "left", .action = "focus_left" },
    //     .{ .key = "right", .action = "focus_right" },
    // },
}
